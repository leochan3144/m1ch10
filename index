let cstate=store.get('m1c10-checks',{});
function renderCheck(sec){
  const box=$('.check[data-sec="'+sec+'"]');if(!box)return;
  const Q=CHECKS[sec],st=cstate[sec]||{};
  let h='<div class="head"><h2>Check Yourself</h2><p class="muted small">Test your core concepts for this section.</p></div>';
  h+=Q.map((q,i)=>{
    const s=st[i];let body='';
    if(q.t==='mcq')body='<div class="qopts">'+q.o.map((o,k)=>`<button class="btn qopt ${s?(k===q.a?'right':(k===s.ans?'wrong':'')):''}" data-cq="${sec}|${i}" data-k="${k}" ${s?'disabled':''}>${String.fromCharCode(65+k)}. ${o}</button>`).join('')+'</div>';
    else body=`<div class="qin"><input id="ci-${sec}-${i}" value="${s?s.ans:''}" ${s?'disabled':''}><button class="btn primary" data-cq="${sec}|${i}" data-check="1" ${s?'disabled':''}>Check</button></div>`;
    const fb=s?`<div class="qfb ${s.ok?'ok':'no'}"><strong>${s.ok?'Correct!':'Incorrect.'}</strong> ${q.e}</div>`:'';
    return `<div class="qcard"><div class="qh"><span class="qn">Q${i+1}</span><span>${q.q}</span></div>${body}${fb}</div>`;
  }).join('');
  box.innerHTML=h;
  if(Object.values(st).length===Q.length&&!done.has(sec)){done.add(sec);refreshProgress();}
}

document.addEventListener('click',e=>{
  const b=e.target.closest('[data-cq]');if(!b)return;
  const [sec,i]=b.dataset.cq.split('|');const q=CHECKS[sec][+i];cstate[sec]=cstate[sec]||{};
  if(q.t==='mcq'){const k=+b.dataset.k;cstate[sec][i]={ans:k,ok:k===q.a};}
  else{
    const val=parseFloat($('#ci-'+sec+'-'+i).value);
    cstate[sec][i]={ans:$('#ci-'+sec+'-'+i).value,ok:Math.abs(val-q.a)<0.005};
  }
  store.set('m1c10-checks',cstate);
  renderCheck(sec);
});

