function initPlayer(p){
  const svg=p.querySelector('.pviz svg');
  let vizFn = VIZ[p.dataset.viz];
  if (!vizFn) vizFn = ((s)=>genericViz(s,p.dataset.viz));

  const go=vizFn(svg);
  const items=$$('.pwork > li',p),n=items.length,empty=p.querySelector('.pempty');
  const ctl=document.createElement('div');ctl.className='pctl';
  ctl.innerHTML=`<button class="btn" data-a="back">◀ Back</button><button class="btn primary" data-a="next">Start ▶</button><span class="dots">${items.map(()=>'<i></i>').join('')}</span><button class="btn ghost" data-a="reset">Restart</button>`;
  p.querySelector('.pmain').after(ctl);
  let c=-1;
  function upd(){
    items.forEach((li,k)=>{li.classList.toggle('on',k<=c);li.classList.toggle('cur',k===c);});
    $$('.dots i',ctl).forEach((d,k)=>d.classList.toggle('on',k<=c));
    empty.hidden=c>=0;
    ctl.querySelector('[data-a="back"]').disabled=c<0;
    ctl.querySelector('[data-a="next"]').disabled=c>=n-1;
    ctl.querySelector('[data-a="next"]').textContent=c<0?'Start ▶':c>=n-1?'Finished':'Next step ▶';
    go(c);
  }
  ctl.addEventListener('click',e=>{
    const a=e.target.closest('[data-a]')?.dataset.a;
    if(a==='next')c=Math.min(n-1,c+1);
    if(a==='back')c=Math.max(-1,c-1);
    if(a==='reset')c=-1;
    if(a)upd();
  });
  upd();
}
$$('.player').forEach(initPlayer);

