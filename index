const VIZ={};
function genericViz(svg,title,meta){
  svg.innerHTML='';
  S(svg,'text',{x:160,y:25,class:'vt','text-anchor':'middle'},title);
  S(svg,'line',{x1:20,x2:300,y1:140,y2:140,class:'axis'});
  let g=S(svg,'g',{class:'fd'});
  if(meta&&meta.bars){
    meta.bars.forEach((b,idx)=>{
      S(g,'rect',{x:40+idx*60,y:140-b.h,width:28,height:b.h,class:b.cls||'bar-v',rx:2});
      S(svg,'text',{x:54+idx*60,y:158,class:'lbl-s','text-anchor':'middle'},b.lbl);
    });
  }
  return (i)=>{ if(i>=0) g.classList.add('in'); else g.classList.remove('in'); };
}

