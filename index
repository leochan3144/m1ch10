/* Interactive Bernoulli Trial Simulator */
(function(){
  let currentExp = 'coin';
  const exps = {
    coin: { title: 'Throw a fair coin', succ: 'Head', fail: 'Tail', p: 0.5 },
    target: { title: 'Shoot at a target', succ: 'Hit (Bullseye)', fail: 'Miss', p: 0.35 },
    qc: { title: 'Test a manufactured product', succ: 'Defective (X=1)', fail: 'Normal (X=0)', p: 0.08 },
    mc: { title: 'Guess 4-choice question', succ: 'Correct', fail: 'Incorrect', p: 0.25 }
  };
  let trials = 0, succs = 0, fails = 0;

  function setExp(key){
    currentExp = key;
    $('#simExpTitle').textContent = exps[key].title;
    $('#simExpResult').textContent = `Success = ${exps[key].succ} | Failure = ${exps[key].fail}`;
    trials = 0; succs = 0; fails = 0;
    updTally();
  }

  function updTally(){
    $('#simTally').textContent = `Trials: ${trials} | Successes (X = 1): ${succs} | Failures (X = 0): ${fails}`;
  }

  $('#btnExpCoin').onclick = () => setExp('coin');
  $('#btnExpTarget').onclick = () => setExp('target');
  $('#btnExpQC').onclick = () => setExp('qc');
  $('#btnExpMC').onclick = () => setExp('mc');

  $('#btnRunTrial').onclick = () => {
    trials++;
    const isSucc = Math.random() < exps[currentExp].p;
    if(isSucc) succs++; else fails++;
    const resText = isSucc ? `Outcome: ${exps[currentExp].succ} (X = 1)` : `Outcome: ${exps[currentExp].fail} (X = 0)`;
    $('#simExpResult').textContent = resText;
    updTally();
  };
})();

/* Binomial Dynamic Chart & Preset Buttons */
(function(){
  const svg=$('#binoDynSvg');if(!svg)return;
  function fact(n){return n<=1?1:n*fact(n-1)}
  function nCr(n,r){return fact(n)/(fact(r)*fact(n-r))}
  function render(){
    const n=+($('#bnSl').value), p=+($('#bpSl').value);
    $('#bnOut').textContent=n; $('#bpOut').textContent=p.toFixed(2);
    svg.innerHTML='';
    S(svg,'line',{x1:20,x2:480,y1:150,y2:150,class:'axis'});
    let probs=[];let maxP=0;
    for(let x=0;x<=n;x++){
      let prob=nCr(n,x)*Math.pow(p,x)*Math.pow(1-p,n-x);
      probs.push(prob);if(prob>maxP)maxP=prob;
    }
    const bw=Math.max(6,Math.min(24,380/(n+1)-4));
    for(let x=0;x<=n;x++){
      const cx=40+x*(420/n);
      const h=(probs[x]/Math.max(0.35,maxP))*120;
      S(svg,'rect',{x:cx-bw/2,y:150-h,width:bw,height:h,class:'bar-v',rx:2});
      S(svg,'text',{x:cx,y:166,class:'lbl-s','text-anchor':'middle'},x);
      if(n<=10) S(svg,'text',{x:cx,y:142-h,class:'lbl-s','text-anchor':'middle'},probs[x].toFixed(2));
    }
    const mean=n*p, vr=n*p*(1-p);
    const skew = p === 0.5 ? 'Symmetrical' : (p < 0.5 ? 'Skewed to the right' : 'Skewed to the left');
    $('#binoStat').innerHTML=`<strong>Shape:</strong> ${skew} &nbsp;|&nbsp; <strong>Mean:</strong> E(X) = ${mean.toFixed(2)} &nbsp;|&nbsp; <strong>Variance:</strong> Var(X) = ${vr.toFixed(2)}`;
  }
  $('#bnSl').addEventListener('input',render);$('#bpSl').addEventListener('input',render);

  $('#btnPresetSym').onclick = () => { $('#bpSl').value = 0.5; render(); };
  $('#btnPresetRight').onclick = () => { $('#bpSl').value = 0.2; render(); };
  $('#btnPresetLeft').onclick = () => { $('#bpSl').value = 0.75; render(); };
  $('#btnPresetLarge').onclick = () => { $('#bnSl').value = 20; render(); };

  render();
})();

