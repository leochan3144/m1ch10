<style>
/* Core Tokens & Layout */
:root{
  --paper:#F3F5F9; --surface:#FFFFFF; --sunk:#E9EDF4; --ink:#15213A; --ink-2:#47546E; --ink-3:#7A869B; --line:#D5DBE6; --grid:rgba(55,85,150,.075);
  --violet:#5F35CC; --violet-soft:#ECE6FC; --on-violet:#FFFFFF;
  --amber:#AD6B00; --amber-soft:#FFF1D4;
  --teal:#0A7C6F; --teal-soft:#D9F1EC;
  --red:#BF372D; --red-soft:#FBE3E0;
  --font-display:'Archivo','Arial Narrow',system-ui,sans-serif;
  --font-body:'IBM Plex Sans',system-ui,-apple-system,'Segoe UI',sans-serif;
  --font-mono:'IBM Plex Mono',ui-monospace,monospace;
}
@media (prefers-color-scheme: dark){:root{
  --paper:#0D131E; --surface:#151D2C; --sunk:#1C2638; --ink:#E6EAF2; --ink-2:#AAB4C7; --ink-3:#77839A; --line:#2A3549; --grid:rgba(150,175,230,.05);
  --violet:#A88CFF; --violet-soft:#272050; --on-violet:#140C2E;
  --amber:#F0B44A; --amber-soft:#3A2D12;
  --teal:#44C6B3; --teal-soft:#113430;
  --red:#F27E74; --red-soft:#401F1C;
  color-scheme:dark}}

*{box-sizing:border-box}
[hidden]{display:none!important}
body{background-color:var(--paper);background-image:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px);background-size:24px 24px;color:var(--ink);font-family:var(--font-body);font-size:16px;line-height:1.6;margin:0;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));padding-block:16px 40px}
.app{display:grid;grid-template-columns:275px minmax(0,1fr);gap:32px;max-width:1300px;margin:0 auto}

/* Sidebar Navigation */
.rail{position:sticky;top:calc(16px + env(safe-area-inset-top,0px));align-self:start;max-height:calc(100vh - 32px);overflow:auto;background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:18px 12px 14px}
.brand{padding:0 8px 12px;border-bottom:1px solid var(--line);margin-bottom:10px;display:flex;flex-direction:column;gap:6px}
.brand .eyebrow{margin:0;font-family:var(--font-mono);font-size:.74rem;letter-spacing:.09em;text-transform:uppercase;color:var(--violet);font-weight:600}
.brand h2{font-family:var(--font-display);font-weight:800;font-size:1.15rem;line-height:1.2;margin:0}
.prog{display:flex;align-items:center;gap:10px;font-family:var(--font-mono);font-size:.74rem;color:var(--ink-2);margin-top:4px}
.prog .track{flex:1;height:6px;border-radius:3px;background:var(--sunk);overflow:hidden}
.prog .fill{height:100%;background:var(--teal);width:0;transition:width .4s}
.nav ol{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:3px}
.nav a{display:grid;grid-template-columns:24px 1fr 16px;align-items:center;gap:8px;padding:8px 8px;border-radius:8px;color:var(--ink-2);text-decoration:none;font-size:.88rem;line-height:1.3}
.nav a .n{font-family:var(--font-mono);font-size:.72rem;color:var(--ink-3);text-align:center;border:1px solid var(--line);border-radius:6px;padding:1px 0}
.nav a .tick{color:var(--teal);font-size:.85rem;visibility:hidden}
.nav a.done .tick{visibility:visible}
.nav a:hover{background:var(--sunk);color:var(--ink)}
.nav a[aria-current="page"]{background:var(--violet-soft);color:var(--ink);font-weight:600}
.nav a[aria-current="page"] .n{border-color:var(--violet);color:var(--violet)}

/* Content Structure */
main{min-width:0}
.view{max-width:940px;display:flex;flex-direction:column;gap:18px;padding-block:4px 30px}
.view > *{margin:0}
.page{display:flex;flex-direction:column;gap:16px;min-width:0}
.page > *{margin:0}
.eyebrow{font-family:var(--font-mono);font-size:.74rem;letter-spacing:.09em;text-transform:uppercase;color:var(--violet);font-weight:600}
h1{font-family:var(--font-display);font-weight:800;font-size:clamp(1.7rem,3.8vw,2.35rem);line-height:1.12;margin:0}
h2{font-family:var(--font-display);font-weight:750;font-size:1.3rem;line-height:1.2;margin:0}
h3{font-family:var(--font-display);font-weight:700;font-size:1.05rem;line-height:1.3;margin:0}
p{max-width:68ch}
.lead{font-size:1.05rem;color:var(--ink-2)}
.head{display:flex;flex-direction:column;gap:6px}
.tb{font-family:var(--font-mono);font-size:.72rem;color:var(--ink-2);background:var(--sunk);border:1px solid var(--line);border-radius:999px;padding:2px 10px}
.term{font-weight:600}
.muted{color:var(--ink-2)}
.small{font-size:.88rem}

/* Sub-nav Tabs */
.subnav{display:flex;flex-wrap:wrap;gap:6px;padding-bottom:6px;border-bottom:1px solid var(--line)}
.sp{font:inherit;font-size:.82rem;display:inline-flex;align-items:center;gap:6px;border:1px solid var(--line);background:var(--surface);color:var(--ink-2);border-radius:999px;padding:.26em .75em .26em .3em;cursor:pointer;line-height:1.3}
.sp .k{font-family:var(--font-mono);font-size:.68rem;width:19px;height:19px;border-radius:50%;display:grid;place-items:center;background:var(--sunk);color:var(--ink-3)}
.sp.seen .k{background:var(--teal-soft);color:var(--teal)}
.sp.ex .k{background:var(--amber-soft);color:var(--amber)}
.sp[aria-current="true"]{border-color:var(--violet);background:var(--violet-soft);color:var(--ink);font-weight:600}
.sp[aria-current="true"] .k{background:var(--violet);color:var(--on-violet)}
.page-foot{display:flex;flex-wrap:wrap;gap:10px;justify-content:space-between;align-items:center;border-top:1px solid var(--line);padding-top:16px;margin-top:10px}

/* Panels, Labs & Definitions */
.lab{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:16px;display:flex;flex-direction:column;gap:12px;min-width:0}
.lab-h{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap}
.tag{font-family:var(--font-mono);font-size:.7rem;letter-spacing:.08em;text-transform:uppercase;color:var(--on-violet);background:var(--violet);border-radius:5px;padding:2px 7px}
.tag.amber{background:var(--amber);color:var(--surface)}
.tag.teal{background:var(--teal);color:var(--surface)}
.svgwrap{overflow-x:auto}
.svgwrap svg{display:block;width:100%;height:auto}
.defn{overflow-wrap:anywhere;min-width:0;background:var(--violet-soft);border-radius:12px;padding:14px 18px;display:flex;flex-direction:column;gap:8px}
.defn > .lbl{font-family:var(--font-mono);font-size:.7rem;letter-spacing:.09em;text-transform:uppercase;color:var(--violet);font-weight:600}
.defn p{margin:0}

/* Notes & Warnings */
details.note{border-radius:12px;padding:0;background:var(--surface);border:1px solid var(--line)}
details.note > summary{cursor:pointer;list-style:none;display:flex;align-items:center;gap:10px;padding:10px 14px;font-weight:600;font-size:.92rem}
details.note > summary::-webkit-details-marker{display:none}
details.note > summary::before{content:"+";font-family:var(--font-mono);width:20px;height:20px;border-radius:5px;display:grid;place-items:center;font-size:.9rem;flex:none}
details.note[open] > summary::before{content:"−"}
details.note > .body{padding:0 16px 14px 44px;display:flex;flex-direction:column;gap:8px;font-size:.94rem}
details.note > .body > *{margin:0}
details.tip > summary::before{background:var(--amber-soft);color:var(--amber)}
details.tip > summary .lb{color:var(--amber)}
details.warn > summary::before{background:var(--red-soft);color:var(--red)}
details.warn > summary .lb{color:var(--red)}
.lb{font-family:var(--font-mono);font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;font-weight:600}

/* Buttons & UI Controls */
.btn{font:inherit;font-size:.88rem;font-weight:500;background:var(--surface);color:var(--ink);border:1px solid var(--line);border-radius:8px;padding:.42em .85em;cursor:pointer;line-height:1.3;transition:background .15s,border-color .15s}
.btn:hover{border-color:var(--ink-3);background:var(--sunk)}
.btn.primary{background:var(--violet);border-color:var(--violet);color:var(--on-violet)}
.btn.primary:hover{filter:brightness(1.08)}
.btn.ghost{border-color:transparent;background:transparent;color:var(--ink-2)}
.btn.ghost:hover{background:var(--sunk)}
.btn:disabled{opacity:.45;cursor:default}
.row{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.grid2{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:14px}
input[type=range]{width:100%;accent-color:var(--violet)}
.slider{display:grid;grid-template-columns:auto 1fr auto;gap:12px;align-items:center}
.slider label{font-family:var(--font-mono);font-size:.84rem}
.slider output{font-family:var(--font-mono);font-size:.9rem;min-width:3em;text-align:right}

/* Tables & Math */
.dt{border-collapse:collapse;font-variant-numeric:tabular-nums;margin:0 auto;width:100%}
.dt th,.dt td{border:1px solid var(--line);padding:6px 11px;text-align:center;min-width:48px}
.dt th{font-family:var(--font-mono);font-weight:500;font-size:.8rem;background:var(--sunk);color:var(--ink-2);white-space:nowrap}
.dtwrap{overflow-x:auto;max-width:100%}
mjx-container[display="true"]{margin:.35em 0 !important}

/* Interactive Step Players */
.player{display:flex;flex-direction:column;gap:12px}
.pq{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:14px 16px;display:flex;flex-direction:column;gap:10px}
.pq .qh{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap}
.pq p{margin:0}
.pq ol.parts{list-style:none;padding-left:0;margin:0;display:flex;flex-direction:column;gap:4px}
.pq ol.parts > li{display:grid;grid-template-columns:2.2em 1fr;gap:2px}
.pmain{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.25fr);gap:16px;align-items:start}
.pviz{position:sticky;top:calc(16px + env(safe-area-inset-top,0px));background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:12px;z-index:2}
.pviz svg{display:block;width:100%;height:auto}
.pwork{list-style:none;margin:0;padding:0;display:flex;flex-direction:column}
.pwork > li{visibility:hidden;max-height:0;opacity:0;overflow:hidden;transition:max-height .5s ease,opacity .35s,margin .3s;margin:0;scroll-margin-top:24px}
.pwork > li.on{visibility:visible;max-height:60em;opacity:1;margin-bottom:10px}
.pwork .w{border-left:3px solid var(--line);padding:4px 0 4px 12px;overflow-x:auto;transition:border-color .3s,background .3s}
.pwork .w p{margin:.1em 0}
.pwork li.cur .w{border-left-color:var(--violet);background:linear-gradient(90deg,var(--violet-soft),transparent 75%)}
.pwork .why{max-height:0;opacity:0;overflow:hidden;transition:max-height .45s ease,opacity .35s,margin .3s;font-size:.88rem;color:var(--ink-2);margin-left:15px}
.pwork li.cur .why{max-height:30em;opacity:1;margin-top:6px}
.pwork .why > div{background:var(--amber-soft);border-radius:8px;padding:7px 11px;color:var(--ink)}
.pwork .why > div::before{content:"Why: ";font-family:var(--font-mono);font-size:.7rem;letter-spacing:.07em;text-transform:uppercase;color:var(--amber);font-weight:600}
.pempty{border:1.5px dashed var(--line);border-radius:12px;padding:14px;color:var(--ink-2);font-size:.92rem;margin:0}
.pctl{position:sticky;bottom:calc(8px + env(safe-area-inset-bottom,0px));z-index:3;display:flex;flex-wrap:wrap;gap:8px;align-items:center;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:8px 10px;box-shadow:0 4px 16px rgba(10,20,40,.08)}
.dots{display:flex;gap:4px;align-items:center}
.dots i{width:8px;height:8px;border-radius:50%;background:var(--line);transition:background .25s}
.dots i.on{background:var(--violet)}
@media (max-width:760px){.pmain{grid-template-columns:minmax(0,1fr)}}

/* SVG Shared Styling */
svg text{font-family:var(--font-body);fill:var(--ink)}
svg .axis{stroke:var(--ink-3);stroke-width:1.5;fill:none}
svg .lbl{fill:var(--ink-2);font-size:13px}
svg .lbl-s{fill:var(--ink-3);font-size:11px;font-family:var(--font-mono)}
svg .vt{font-size:13px;font-weight:600;fill:var(--ink)}
svg .note{fill:var(--amber);font-weight:600;font-size:12px}
svg .bar-v{fill:var(--violet)}
svg .bar-a{fill:var(--amber)}
svg .bar-t{fill:var(--teal)}
svg .bar-r{fill:var(--red)}
svg .bar-g{fill:var(--ink-3)}
.fd{opacity:0;transition:opacity .45s}
.fd.in{opacity:1}

/* Tree Diagram Styling */
.tree-branch{stroke:var(--line);stroke-width:1.6;fill:none;transition:stroke .3s,stroke-width .3s}
.tree-branch.hl-teal{stroke:var(--teal);stroke-width:2.5}
.tree-branch.hl-amber{stroke:var(--amber);stroke-width:2.5}
.tree-lbl{transition:fill .3s,font-weight .3s}
.tree-lbl.hl-teal{fill:var(--teal);font-weight:700}
.tree-lbl.hl-amber{fill:var(--amber);font-weight:700}

/* Check Quizzes */
.qcard{border:1px solid var(--line);border-radius:12px;background:var(--surface);padding:14px 16px;display:flex;flex-direction:column;gap:10px}
.qcard .qh{display:flex;gap:10px;align-items:baseline}
.qcard .qn{font-family:var(--font-mono);font-size:.78rem;color:var(--violet);white-space:nowrap}
.qopts{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,210px),1fr));gap:8px}
.qopt{text-align:left}
.qopt.right{background:var(--teal-soft);border-color:var(--teal)}
.qopt.wrong{background:var(--red-soft);border-color:var(--red)}
.qin{display:flex;gap:8px;flex-wrap:wrap}
.qin input{font:inherit;font-family:var(--font-mono);padding:.4em .6em;border:1px solid var(--line);border-radius:8px;background:var(--paper);color:var(--ink);width:9em}
.qfb{font-size:.88rem;border-radius:8px;padding:8px 12px}
.qfb.ok{background:var(--teal-soft)} .qfb.no{background:var(--red-soft)}
.score{font-family:var(--font-display);font-weight:800;font-size:1.6rem}
textarea{width:100%;min-height:120px;font:inherit;padding:10px 12px;border:1px solid var(--line);border-radius:10px;background:var(--surface);color:var(--ink);resize:vertical}

/* Exploration Callout Card */
.guide-card{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:12px 14px;font-size:.9rem}
.guide-card h4{margin:0 0 4px;font-size:.92rem;color:var(--violet)}
.guide-card p{margin:0}

@media (max-width:900px){
  .app{grid-template-columns:minmax(0,1fr);gap:16px}
  .rail{position:static;max-height:none;border-radius:12px;padding:10px 8px 8px}
  .brand{flex-direction:row;align-items:center;justify-content:space-between;gap:12px;padding:0 6px 8px;margin-bottom:6px}
  .brand .eyebrow{display:none}
  .nav ol{flex-direction:row;overflow-x:auto;gap:4px;padding-bottom:4px}
  .nav a{white-space:nowrap;grid-template-columns:auto auto auto;gap:6px;padding:6px 9px}
}
