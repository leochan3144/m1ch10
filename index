/* Example 10.7 Tree Diagram Controller */
VIZ.ex107=(svg)=>{
  const b1 = svg.querySelectorAll('.b1');
  const b2 = svg.querySelectorAll('.b2');
  const b2a = svg.querySelectorAll('.b2a');
  return (i)=>{
    svg.querySelectorAll('.tree-branch, .tree-lbl').forEach(el=>{
      el.classList.remove('hl-teal','hl-amber');
    });
    if(i===1){
      // (a) Only first sample -> satisfactory
      b1.forEach(el=>el.classList.add('hl-teal'));
    } else if(i===2){
      // (b) Re-sampling needed
      b2.forEach(el=>el.classList.add('hl-amber'));
    } else if(i>=3){
      // (c) Total satisfactory paths (Stage 1 direct + Stage 2 re-sampling)
      b1.forEach(el=>el.classList.add('hl-teal'));
      b2.forEach(el=>el.classList.add('hl-teal'));
      b2a.forEach(el=>el.classList.add('hl-teal'));
    }
  };
};

